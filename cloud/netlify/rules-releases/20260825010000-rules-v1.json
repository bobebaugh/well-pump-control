{
  "schemaVersion": 1,
  "kind": "well-pump-rules-release",
  "releaseId": "20260825010000-rules-v1",
  "rulesVersion": 1,
  "rulesSchemaVersion": 1,
  "sourceWorkbook": "well_pump_operational_rules_1.xlsx",
  "rules": [
    {"id":"P001","event":"Pump started","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"pumpState":"Stopped->Running"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"P002","event":"Pump stopped","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"pumpState":"Running->Stopped"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"P003","event":"Cycle completed","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"cycle_completed"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"P004","event":"Pump failed to start","enabled":false,"level":"Red","response":"Alert","confirmSeconds":5,"clearSeconds":1,"conditions":{"sw0":"0V (qualified demand)","r0":"Closed","pumpState":"Stopped"},"recoveryResetPolicy":"Clear on EM-confirmed run or demand removal","notify":true,"commissioningStatus":"Ready"},
    {"id":"P005","event":"Manual or bypass operation inferred - SW0","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"sw0":"Open","pumpState":"Running"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"P006","event":"Manual or bypass operation inferred - R0","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"r0":"Open","pumpState":"Running"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"P007","event":"Rapid cycling observed","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":60,"conditions":{"startsIn60Seconds":">4"},"recoveryResetPolicy":"No Tab5 Trip; Shelly script owns anti-cycling","notify":true,"commissioningStatus":"Ready"},
    {"id":"P008","event":"Shelly rapid-cycle incident","enabled":false,"level":null,"response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"cntr":"change by +1"},"recoveryResetPolicy":"Shelly script applies its 60-second inhibit","notify":true,"commissioningStatus":"Ready"},
    {"id":"P009","event":"Shelly rapid-cycle timed inhibit","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"shellyLocalLockout":"Timed 60-second inhibit"},"recoveryResetPolicy":"Shelly script restores permission","notify":true,"commissioningStatus":"Ready"},
    {"id":"P010","event":"Shelly rapid-cycle one-hour lockout","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"shellyLocalLockout":"One-hour lockout","loCntr":"<3"},"recoveryResetPolicy":"Shelly script expires lockout after one hour","notify":true,"commissioningStatus":"Ready"},
    {"id":"P011","event":"Shelly rapid-cycle manual lockout","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"shellyLocalLockout":"LO manual lockout","loCntr":">=3"},"recoveryResetPolicy":"Wellhead power cycle or authorized Tab5 override","notify":true,"commissioningStatus":"Ready"},
    {"id":"P012","event":"Extended runtime","enabled":false,"level":"Yellow","response":"Alert","scheduleContext":"Cycle started 04:00-04:15 fixed UTC-04:00; context retained through completion","confirmSeconds":1,"clearSeconds":30,"conditions":{"pumpState":"Running","runtimeSeconds":">360"},"operatingContext":"Scheduled filter flush","notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"P013","event":"Long runtime - normal","enabled":false,"level":"Red","response":"Trip—latched/manual reset","scheduleContext":"Cycle started outside 04:00-04:15 fixed UTC-04:00","confirmSeconds":1,"clearSeconds":30,"conditions":{"pumpState":"Running","runtimeSeconds":">360"},"operatingContext":"Normal","recoveryResetPolicy":"Manual reset after cause review","notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"P014","event":"Long runtime - flush","enabled":false,"level":"Red","response":"Trip—latched/manual reset","scheduleContext":"Cycle started 04:00-04:15 fixed UTC-04:00; context retained through completion","confirmSeconds":1,"clearSeconds":30,"conditions":{"pumpState":"Running","runtimeSeconds":">1800"},"operatingContext":"Scheduled filter flush","recoveryResetPolicy":"Manual reset after cause review","notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"P015","event":"Cycle runtime outlier","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"cycle_completed","runtimeSeconds":"outside accepted cycle baseline"},"notify":true,"commissioningStatus":"Needs baseline"},
    {"id":"P016","event":"Cycle fill outlier","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"cycle_completed","estimatedTankWaterGallons":"outside accepted cycle baseline"},"notify":true,"commissioningStatus":"Needs tank model"},
    {"id":"E001","event":"Pump running underload","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":4,"clearSeconds":30,"conditions":{"pumpState":"Running","loadRatioPct":"75-80"},"notify":true,"commissioningStatus":"Provisional threshold"},
    {"id":"E002","event":"Pump running underload","enabled":false,"level":"Red","response":"Trip—recovery policy","confirmSeconds":4,"clearSeconds":30,"conditions":{"pumpState":"Running","loadRatioPct":"<75"},"recoveryResetPolicy":"30-minute first retry; shared restart budget applies","notify":true,"commissioningStatus":"Provisional control"},
    {"id":"E003","event":"Underload with no fill corroboration","enabled":false,"level":"Red","response":"Alert","confirmSeconds":4,"clearSeconds":30,"conditions":{"pumpState":"Running","loadRatioPct":"<75","pressureSlopePsiMin":"<=0","estimatedTankNetFlowGpm":"<=0"},"recoveryResetPolicy":"Follows underload lockout if E002 is ON","notify":true,"commissioningStatus":"Needs tank model"},
    {"id":"E004","event":"Pump running overload","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":5,"clearSeconds":30,"conditions":{"pumpRealPowerW":">=2950","pumpState":"Running","loadRatioPct":"<125"},"notify":true,"commissioningStatus":"Provisional threshold"},
    {"id":"E005","event":"Pump running overload","enabled":false,"level":"Red","response":"Trip—latched/manual reset","confirmSeconds":5,"clearSeconds":30,"conditions":{"pumpState":"Running","loadRatioPct":">=125"},"recoveryResetPolicy":"Manual reset only; no automatic retry","notify":true,"commissioningStatus":"Provisional control"},
    {"id":"E006","event":"Utility voltage low","enabled":false,"level":"Red","response":"Trip—while active","confirmSeconds":2,"clearSeconds":30,"conditions":{"supplyVoltageV":"<190","emValidity":"Valid"},"recoveryResetPolicy":"Release after 30 seconds valid voltage; restart budget exempt","notify":true,"commissioningStatus":"Ready for commissioning"},
    {"id":"E007","event":"Utility voltage high","enabled":false,"level":"Red","response":"Trip—while active","confirmSeconds":2,"clearSeconds":30,"conditions":{"supplyVoltageV":">265","emValidity":"Valid"},"recoveryResetPolicy":"Release after 30 seconds valid voltage; restart budget exempt","notify":true,"commissioningStatus":"Ready for commissioning"},
    {"id":"E008","event":"Power step outlier","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":1,"clearSeconds":5,"conditions":{"pumpState":"Running","powerChangeW":"outside accepted transition envelope"},"notify":true,"commissioningStatus":"Needs baseline"},
    {"id":"E009","event":"Voltage step outlier","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":1,"clearSeconds":5,"conditions":{"voltageChangeV":"outside accepted transition envelope"},"notify":true,"commissioningStatus":"Needs baseline"},
    {"id":"T001","event":"Pressure low","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":10,"clearSeconds":10,"conditions":{"pressurePsi":"38-39.9","pressureValidity":"Valid","pumpState":"Running"},"notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"T002","event":"Pressure low","enabled":false,"level":"Red","response":"Alert","confirmSeconds":10,"clearSeconds":10,"conditions":{"pressurePsi":"<38","pressureValidity":"Valid","pumpState":"Running"},"notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"T003","event":"Pressure high","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":5,"clearSeconds":10,"conditions":{"pressurePsi":"60.1-69.9","pressureValidity":"Valid"},"notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"T004","event":"Pressure high","enabled":false,"level":"Red","response":"Trip—recovery policy","confirmSeconds":2,"clearSeconds":30,"conditions":{"pressurePsi":">=70","pressureValidity":"Valid"},"recoveryResetPolicy":"Release after pressure is in recovery range for Clear sec; budget applies","notify":true,"commissioningStatus":"Confirmed threshold; await traces"},
    {"id":"T005","event":"Pressure not rising while running","enabled":false,"level":"Red","response":"Alert","confirmSeconds":10,"clearSeconds":30,"conditions":{"pumpState":"Running","runtimeSeconds":">10","pressureSlopePsiMin":"<=0"},"notify":true,"commissioningStatus":"Ready after calibration"},
    {"id":"T006","event":"Pressure stalled while running","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":15,"clearSeconds":30,"conditions":{"pumpState":"Running","runtimeSeconds":">10","pressureSlopePsiMin":"-0.2-0.2"},"notify":true,"commissioningStatus":"Provisional threshold"},
    {"id":"T007","event":"Tank filling","enabled":false,"level":null,"response":"Observe","confirmSeconds":2,"clearSeconds":2,"conditions":{"pumpState":"Running","pressureSlopePsiMin":">0.2"},"notify":false,"commissioningStatus":"Await monitoring traces"},
    {"id":"T008","event":"Tank fill rate low","enabled":false,"level":"Yellow","response":"Alert","scheduleContext":"Outside scheduled filter flush","confirmSeconds":15,"clearSeconds":30,"conditions":{"pumpState":"Running","runtimeSeconds":">10","estimatedTankNetFlowGpm":"<4"},"operatingContext":"Normal","notify":true,"commissioningStatus":"Estimated threshold; await traces"},
    {"id":"T009","event":"Negative tank net flow while running","enabled":false,"level":"Red","response":"Alert","scheduleContext":"Outside scheduled filter flush","confirmSeconds":10,"clearSeconds":30,"conditions":{"pumpState":"Running","estimatedTankNetFlowGpm":"<0"},"operatingContext":"Normal","notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"T010","event":"Unexpected draw while stopped","enabled":false,"level":"Yellow","response":"Alert","scheduleContext":"Outside scheduled filter flush","confirmSeconds":10,"clearSeconds":30,"conditions":{"pumpState":"Stopped","stoppedSeconds":">5","estimatedTankNetFlowGpm":"<-0.5"},"operatingContext":"Normal","notify":true,"commissioningStatus":"Await monitoring traces"},
    {"id":"T011","event":"Pressure decay outlier","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":30,"clearSeconds":30,"conditions":{"pumpState":"Stopped","pressureSlopePsiMin":"<[COMMISSION_DECAY_LIMIT]"},"notify":true,"commissioningStatus":"Needs baseline"},
    {"id":"T012","event":"Drawdown outlier","enabled":false,"level":"Yellow","response":"Alert","scheduleContext":"Outside scheduled filter flush","confirmSeconds":30,"clearSeconds":30,"conditions":{"pumpState":"Stopped","estimatedTankNetFlowGpm":"<-6"},"operatingContext":"Normal","notify":true,"commissioningStatus":"Estimated threshold; await traces"},
    {"id":"T013","event":"Pressure equipment-risk limit","enabled":false,"level":"Red","response":"Trip—latched/manual reset","confirmSeconds":1,"clearSeconds":60,"conditions":{"pressurePsi":">=100","pressureValidity":"Valid"},"recoveryResetPolicy":"Manual reset only after equipment inspection","notify":true,"commissioningStatus":"Confirmed threshold; await traces"},
    {"id":"H001","event":"Electrical source invalid or stale","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"emValidity":"Valid->Unknown"},"recoveryResetPolicy":"Clear on first fresh qualified sample","notify":true,"commissioningStatus":"Ready"},
    {"id":"H002","event":"Electrical source recovered","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"emValidity":"Unknown->Valid"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H003","event":"Pressure source invalid or stale","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"pressureValidity":"Valid->Unknown"},"recoveryResetPolicy":"Clear on first fresh qualified sample","notify":true,"commissioningStatus":"Ready"},
    {"id":"H004","event":"Pressure source recovered","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"pressureValidity":"Unknown->Valid"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H005","event":"Shelly control source invalid or stale","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"shellyValidity":"Valid->Unknown"},"recoveryResetPolicy":"Clear on first fresh qualified sample","notify":true,"commissioningStatus":"Ready"},
    {"id":"H006","event":"Shelly control source recovered","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"shellyValidity":"Unknown->Valid"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H007","event":"Wi-Fi unavailable","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":5,"clearSeconds":1,"conditions":{"wifiState":"Connected->Unavailable"},"recoveryResetPolicy":"Clear on reconnect","notify":true,"commissioningStatus":"Ready"},
    {"id":"H008","event":"Wi-Fi recovered","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"wifiState":"Unavailable->Connected"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H009","event":"Cloud unavailable","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":30,"clearSeconds":1,"conditions":{"cloudState":"Available->Unavailable"},"recoveryResetPolicy":"Clear on durable delivery recovery","notify":true,"commissioningStatus":"Ready"},
    {"id":"H010","event":"Cloud recovered","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"cloudState":"Unavailable->Available"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H011","event":"Cloud outage extended","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"cloudOutageSeconds":">3600"},"recoveryResetPolicy":"Clear when cloud returns","notify":true,"commissioningStatus":"Provisional threshold"},
    {"id":"H012","event":"Clock invalid","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"clockValidity":"Valid->Invalid"},"recoveryResetPolicy":"Use conservative normal runtime context","notify":true,"commissioningStatus":"Ready"},
    {"id":"H013","event":"Clock recovered","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"clockValidity":"Invalid->Valid"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H014","event":"RAM queue near full","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":5,"clearSeconds":10,"conditions":{"bufferUsedPct":">=80"},"recoveryResetPolicy":"Clear below threshold for Clear sec","notify":true,"commissioningStatus":"Provisional threshold"},
    {"id":"H015","event":"RAM queue overflow","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"recordsLost":"change by >0"},"notify":true,"commissioningStatus":"Ready"},
    {"id":"H016","event":"History gap","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"history_gap_detected"},"notify":true,"commissioningStatus":"Ready"},
    {"id":"H017","event":"Tab5 boot or unexpected restart","enabled":false,"level":"Yellow","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"boot_or_unexpected_restart"},"recoveryResetPolicy":"Restore persisted lockouts and restart budget","notify":true,"commissioningStatus":"Ready"},
    {"id":"H018","event":"Wellhead power restored","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"new_shelly_boot_session"},"recoveryResetPolicy":"Clear old Tab5 lockout board and restart budget","notify":false,"commissioningStatus":"Ready"},
    {"id":"H019","event":"Configuration applied","enabled":false,"level":null,"response":"Observe","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"configuration_revision_applied"},"notify":false,"commissioningStatus":"Ready"},
    {"id":"H020","event":"Configuration rejected","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"configuration_revision_rejected"},"recoveryResetPolicy":"Keep last-known-good revision and retry read/validation","notify":true,"commissioningStatus":"Ready"},
    {"id":"H021","event":"Tank model invalid","enabled":false,"level":"Red","response":"Alert","confirmSeconds":1,"clearSeconds":1,"conditions":{"systemEvent":"tank_model_invalid"},"recoveryResetPolicy":"Suppress dependent tank-volume and net-flow rules","notify":true,"commissioningStatus":"Ready"}
  ]
}
