{
  "rules": {
    ".read": false,
    ".write": false,
    "v1": {
      "sites": {
        "well-main": {
          "devices": {
            "tab5-well-main": {
              "currentObservation": {
                ".read": "auth != null && auth.uid == 'tab5-well-main'",
                ".write": "auth != null && auth.uid == 'tab5-well-main' && newData.child('schemaVersion').val() == 1 && newData.child('siteId').val() == 'well-main' && newData.child('deviceId').val() == 'tab5-well-main'"
              },
              "presence": {
                ".read": "auth != null && auth.uid == 'tab5-well-main'",
                ".write": "auth != null && auth.uid == 'tab5-well-main' && newData.child('schemaVersion').val() == 1 && newData.child('sessionId').isString()"
              },
              "syncState": {
                ".read": "auth != null && auth.uid == 'tab5-well-main'",
                ".write": "auth != null && auth.uid == 'tab5-well-main' && newData.child('schemaVersion').val() == 1 && newData.child('sessionId').isString()"
              },
              "commands": {
                ".read": "auth != null && auth.uid == 'tab5-well-main'",
                ".write": false,
                ".indexOn": ["commandSequence", "status"]
              }
            }
          },
          "control": {
            "globalEnable": {
              ".read": "auth != null && auth.uid == 'tab5-well-main'",
              ".write": false
            }
          },
          "rules": {
            "current": {
              ".read": "auth != null && auth.uid == 'tab5-well-main'",
              ".write": false
            }
          }
        }
      }
    }
  }
}
