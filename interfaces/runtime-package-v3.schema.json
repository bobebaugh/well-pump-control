{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-pump-control.example/contracts/rules-runtime-package-v3.schema.json",
  "title": "Well Pump Event V3 Runtime Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseId", "packageVersion", "adoption", "lifecycle", "devices", "calculations", "systemFields", "events"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "well-pump-event-runtime-v3" },
    "releaseId": { "type": "string", "pattern": "^[0-9]{14}-event-v3-v[1-9][0-9]*$" },
    "packageVersion": { "type": "integer", "minimum": 1 },
    "adoption": { "$ref": "#/$defs/adoption" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "devices": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/device" } },
    "calculations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/calculation" } },
    "systemFields": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/systemField" } },
    "events": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{1,63}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$" },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "comparisonValue": { "oneOf": [ { "$ref": "#/$defs/scalar" }, { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } ] },
    "logging": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["none", "change", "always"] } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "threshold"], "properties": { "mode": { "const": "delta" }, "threshold": { "type": "number", "exclusiveMinimum": 0 } } }
      ]
    },
    "adoption": { "type": "object", "additionalProperties": false, "required": ["runtimeSchemaVersion", "legacyPackagePolicy"], "properties": { "runtimeSchemaVersion": { "const": 3 }, "legacyPackagePolicy": { "const": "reject" } } },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["qualification", "ownership", "monitor"],
      "properties": {
        "qualification": { "type": "object", "additionalProperties": false, "required": ["observationCount", "minimumSeconds", "countAndTimeBothRequired", "missingEvidence"], "properties": { "observationCount": { "const": "consecutive" }, "minimumSeconds": { "const": "continuous" }, "countAndTimeBothRequired": { "const": true }, "missingEvidence": { "const": "freezes_qualification" } } },
        "ownership": { "const": "event_instance_set" },
        "monitor": { "type": "object", "additionalProperties": false, "required": ["resource"], "properties": { "resource": { "const": "declared_operating_mode" } } }
      }
    },
    "write": { "type": "object", "additionalProperties": false, "required": ["method", "parameters", "normalValue"], "properties": { "method": { "type": "string" }, "parameters": { "type": "object", "additionalProperties": false, "required": ["id", "valueParameter"], "properties": { "id": { "type": "integer", "minimum": 0, "maximum": 255 }, "valueParameter": { "$ref": "#/$defs/name" } } }, "normalValue": { "$ref": "#/$defs/scalar" } } },
    "field": { "type": "object", "additionalProperties": false, "required": ["systemName", "type", "unit", "logging", "object", "access"], "properties": { "systemName": { "$ref": "#/$defs/name" }, "type": { "enum": ["number", "integer", "boolean", "enum", "signal"] }, "unit": { "type": ["string", "null"] }, "enumValues": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "type": "string" } }, "logging": { "$ref": "#/$defs/logging" }, "object": { "type": "string", "minLength": 1, "maxLength": 128 }, "access": { "enum": ["read", "readWrite"] }, "write": { "$ref": "#/$defs/write" } } },
    "device": { "type": "object", "additionalProperties": false, "required": ["id", "driver", "address", "enabled", "fields"], "properties": { "id": { "$ref": "#/$defs/id" }, "driver": { "type": "string" }, "address": { "type": "string", "minLength": 1 }, "enabled": { "type": "boolean" }, "fields": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/field" } } } },
    "calculatedOutput": { "type": "object", "additionalProperties": false, "required": ["systemName", "type", "unit", "logging"], "properties": { "systemName": { "$ref": "#/$defs/name" }, "type": { "enum": ["number", "integer", "boolean", "enum", "signal"] }, "unit": { "type": ["string", "null"] }, "enumValues": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "type": "string" } }, "logging": { "$ref": "#/$defs/logging" } } },
    "programToken": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [ { "enum": ["number", "field", "operator"] }, { "type": ["number", "string"] } ], "items": false },
    "expressionCalculation": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "expression", "program", "output"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "expression" }, "expression": { "type": "string", "maxLength": 512 }, "program": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/programToken" } }, "output": { "$ref": "#/$defs/calculatedOutput" } } },
    "functionCalculation": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "functionId", "inputs", "parameters", "outputs"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "function" }, "functionId": { "const": "boyle_tank" }, "inputs": { "type": "object", "additionalProperties": false, "required": ["pressure"], "properties": { "pressure": { "$ref": "#/$defs/name" } } }, "parameters": { "type": "object", "additionalProperties": false, "required": ["effectiveTankGallons", "prechargeGaugePsi", "atmosphericPressurePsi", "regressionWindowSeconds", "minimumSamples"], "properties": { "effectiveTankGallons": { "type": "number" }, "prechargeGaugePsi": { "type": "number" }, "atmosphericPressurePsi": { "type": "number" }, "regressionWindowSeconds": { "type": "number" }, "minimumSamples": { "type": "number" } } }, "outputs": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/calculatedOutput" } } } },
    "calculation": { "oneOf": [ { "$ref": "#/$defs/expressionCalculation" }, { "$ref": "#/$defs/functionCalculation" } ] },
    "operatingModeSystemField": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "label", "source", "runtimeRole", "type", "unit", "enumValues", "initialValue", "logging", "assignmentTarget"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "source": { "const": "session" }, "runtimeRole": { "const": "operatingMode" }, "type": { "const": "enum" }, "unit": { "type": ["string", "null"] }, "enumValues": { "const": ["Normal", "Monitor"] }, "initialValue": { "const": "Normal" }, "logging": { "$ref": "#/$defs/logging" }, "assignmentTarget": { "const": true } } },
    "workingNumberSystemField": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "label", "source", "runtimeRole", "type", "unit", "initialValue", "logging", "assignmentTarget"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "source": { "const": "session" }, "runtimeRole": { "const": "working" }, "type": { "const": "number" }, "unit": { "type": ["string", "null"] }, "initialValue": { "type": "number" }, "logging": { "$ref": "#/$defs/logging" }, "assignmentTarget": { "type": "boolean" } } },
    "workingIntegerSystemField": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "label", "source", "runtimeRole", "type", "unit", "initialValue", "logging", "assignmentTarget"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "source": { "const": "session" }, "runtimeRole": { "const": "working" }, "type": { "const": "integer" }, "unit": { "type": ["string", "null"] }, "initialValue": { "type": "integer" }, "logging": { "$ref": "#/$defs/logging" }, "assignmentTarget": { "type": "boolean" } } },
    "workingBooleanSystemField": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "label", "source", "runtimeRole", "type", "unit", "initialValue", "logging", "assignmentTarget"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "source": { "const": "session" }, "runtimeRole": { "const": "working" }, "type": { "const": "boolean" }, "unit": { "type": ["string", "null"] }, "initialValue": { "type": "boolean" }, "logging": { "$ref": "#/$defs/logging" }, "assignmentTarget": { "type": "boolean" } } },
    "workingEnumSystemField": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "label", "source", "runtimeRole", "type", "unit", "enumValues", "initialValue", "logging", "assignmentTarget"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "source": { "const": "session" }, "runtimeRole": { "const": "working" }, "type": { "const": "enum" }, "unit": { "type": ["string", "null"] }, "enumValues": { "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "initialValue": { "type": "string" }, "logging": { "$ref": "#/$defs/logging" }, "assignmentTarget": { "type": "boolean" } } },
    "occurrenceSystemField": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "label", "source", "runtimeRole", "type", "unit", "occurrenceKey", "logging"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "source": { "enum": ["manualOccurrence", "internalOccurrence"] }, "runtimeRole": { "const": "occurrence" }, "type": { "const": "signal" }, "unit": { "type": ["string", "null"] }, "occurrenceKey": { "$ref": "#/$defs/name" }, "logging": { "$ref": "#/$defs/logging" } } },
    "systemField": { "oneOf": [ { "$ref": "#/$defs/operatingModeSystemField" }, { "$ref": "#/$defs/workingNumberSystemField" }, { "$ref": "#/$defs/workingIntegerSystemField" }, { "$ref": "#/$defs/workingBooleanSystemField" }, { "$ref": "#/$defs/workingEnumSystemField" }, { "$ref": "#/$defs/occurrenceSystemField" } ] },
    "clause": { "type": "object", "additionalProperties": false, "required": ["field", "operator", "value"], "properties": { "field": { "$ref": "#/$defs/name" }, "operator": { "enum": ["lt", "lte", "gt", "gte", "eq", "neq", "between", "outside", "changes", "changes_from", "changes_to", "occurs"] }, "value": { "$ref": "#/$defs/comparisonValue" } } },
    "qualifiedCondition": { "type": "object", "additionalProperties": false, "required": ["mode", "clauses", "observationCount", "minimumSeconds"], "properties": { "mode": { "enum": ["all", "any"] }, "clauses": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/clause" } }, "observationCount": { "type": "integer", "minimum": 1, "maximum": 86400 }, "minimumSeconds": { "type": "number", "minimum": 0, "maximum": 86400 } } },
    "guard": { "type": "object", "additionalProperties": false, "required": ["mode", "clauses"], "properties": { "mode": { "enum": ["all", "any"] }, "clauses": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/clause" } } } },
    "trigger": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["type", "condition"], "properties": { "type": { "const": "condition" }, "condition": { "$ref": "#/$defs/qualifiedCondition" } } }, { "type": "object", "additionalProperties": false, "required": ["type", "occurrenceField", "qualification"], "properties": { "type": { "enum": ["manual", "internal"] }, "occurrenceField": { "$ref": "#/$defs/name" }, "qualification": { "type": "object", "additionalProperties": false, "required": ["observationCount", "minimumSeconds"], "properties": { "observationCount": { "type": "integer", "minimum": 1, "maximum": 86400 }, "minimumSeconds": { "type": "number", "minimum": 0, "maximum": 86400 } } } } } ] },
    "closing": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["policy", "condition"], "properties": { "policy": { "const": "condition" }, "condition": { "$ref": "#/$defs/qualifiedCondition" } } }, { "type": "object", "additionalProperties": false, "required": ["policy"], "properties": { "policy": { "enum": ["clearEvents", "immediate"] } } } ] },
    "assignment": { "type": "object", "additionalProperties": false, "required": ["target", "value", "ownership"], "properties": { "target": { "$ref": "#/$defs/name" }, "value": { "$ref": "#/$defs/scalar" }, "ownership": { "enum": ["transition", "whileOpen"] } } },
    "guardedGroup": { "type": "object", "additionalProperties": false, "required": ["guard", "assignments"], "properties": { "guard": { "$ref": "#/$defs/guard" }, "assignments": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/assignment" } } } },
    "phase": { "type": "object", "additionalProperties": false, "required": ["assignments", "guardedGroups"], "properties": { "assignments": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/assignment" } }, "guardedGroups": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/guardedGroup" } } } },
    "summaryOutput": { "type": "object", "additionalProperties": false, "required": ["systemName", "label", "type", "unit", "logging"], "properties": { "systemName": { "$ref": "#/$defs/name" }, "label": { "type": "string", "minLength": 1 }, "type": { "enum": ["number", "integer"] }, "unit": { "type": ["string", "null"] }, "logging": { "$ref": "#/$defs/logging" } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["durationOutput", "aggregates"], "properties": { "durationOutput": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/summaryOutput" } ] }, "aggregates": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["source", "operation", "scale", "output"], "properties": { "source": { "$ref": "#/$defs/name" }, "operation": { "enum": ["start", "end", "delta", "average", "minimum", "maximum"] }, "scale": { "type": "number" }, "output": { "$ref": "#/$defs/summaryOutput" } } } } } },
    "event": { "type": "object", "additionalProperties": false, "required": ["id", "systemName", "displayName", "severity", "enabled", "eventClass", "opening", "closing", "onOpen", "onClose", "summary"], "properties": { "id": { "$ref": "#/$defs/id" }, "systemName": { "$ref": "#/$defs/name" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 160 }, "severity": { "enum": ["Info", "Yellow", "Red"] }, "enabled": { "type": "boolean" }, "eventClass": { "enum": ["transient", "latched", "monitor"] }, "opening": { "type": "object", "additionalProperties": false, "required": ["trigger"], "properties": { "trigger": { "$ref": "#/$defs/trigger" } } }, "closing": { "$ref": "#/$defs/closing" }, "onOpen": { "$ref": "#/$defs/phase" }, "onClose": { "$ref": "#/$defs/phase" }, "summary": { "$ref": "#/$defs/summary" } } }
  }
}
