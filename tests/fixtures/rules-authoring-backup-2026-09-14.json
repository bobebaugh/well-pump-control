          "closeMessage": ""
        }
      },
      {
        "id": "S020",
        "systemName": "ShellyOffline",
        "displayName": "Shelly Offline",
        "enabled": true,
        "severity": "Info",
        "eventClass": "transient",
        "opening": {
          "trigger": {
            "type": "condition",
            "condition": {
              "mode": "all",
              "clauses": [
                {
                  "field": "Shelly1Available",
                  "operator": "eq",
                  "value": false
                }
              ],
              "observationCount": 2,
              "minimumSeconds": 0
            }
          }
        },
        "closing": {
          "policy": "condition",
          "condition": {
            "mode": "all",
            "clauses": [
              {
                "field": "Shelly1Available",
                "operator": "eq",
                "value": true
              }
            ],
            "observationCount": 2,
            "minimumSeconds": 0
          }
