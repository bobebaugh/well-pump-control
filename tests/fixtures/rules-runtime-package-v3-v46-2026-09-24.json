  "calculations": [
    {
      "expression": "(PumpWatts / 2900) * 100",
      "id": "calc-load-ratio",
      "kind": "expression",
      "output": {
        "logging": {
          "mode": "always"
        },
        "systemName": "LoadRatioPercent",
        "type": "number",
        "unit": "%"
      },
      "program": [
        [
          "field",
          "PumpWatts"
        ],
        [
          "number",
          2900
        ],
        [
          "operator",
          "/"
        ],
        [
          "number",
          100
        ],
        [
          "operator",
          "*"
        ]
      ]
    },
    {
      "expression": "(PressureADCCounts - 3732.02) / 211.492",
      "id": "calc-pressure",
      "kind": "expression",
      "output": {
        "logging": {
          "mode": "always"
        },
        "systemName": "PressurePSI",
        "type": "number",
        "unit": "psi"
      },
      "program": [
        [
          "field",
          "PressureADCCounts"
        ],
        [
          "number",
          3732.02
        ],
        [
          "operator",
          "-"
        ],
        [
          "number",
          211.492
        ],
        [
          "operator",
          "/"
        ]
      ]
    },
    {
      "functionId": "boyle_tank",
      "id": "calc-tank",
      "inputs": {
        "pressure": "PressurePSI"
      },
      "kind": "function",
      "outputs": [
        {
          "logging": {
            "mode": "delta",
            "threshold": 1
          },
          "systemName": "TankWaterGallons",
          "type": "number",
          "unit": "gal"
        },
        {
          "logging": {
            "mode": "always"
          },
          "systemName": "PressureSlopePSIPerMinute",
          "type": "number",
          "unit": "psi/min"
        },
        {
          "logging": {
            "mode": "delta",
            "threshold": 1.5
          },
          "systemName": "TankNetFlowGPM",
          "type": "number",
          "unit": "GPM"
        },
        {
          "logging": {
            "mode": "always"
          },
          "systemName": "PumpOffDemandGPM",
          "type": "number",
          "unit": "GPM"
        },
        {
          "enumValues": [
            "VALID",
            "INSUFFICIENT_HISTORY",
            "PRESSURE_INVALID",
            "SAMPLE_GAP",
            "TREND_UNRESOLVED",
            "TANK_MODEL_INVALID"
          ],
          "logging": {
            "mode": "always"
          },
          "systemName": "TankFlowQuality",
          "type": "enum",
          "unit": null
        }
      ],
      "parameters": {
        "atmosphericPressurePsi": 13.07,
        "effectiveTankGallons": 79.3,
        "minimumSamples": 2,
        "prechargeGaugePsi": 38,
        "regressionWindowSeconds": 6
      }
    }
