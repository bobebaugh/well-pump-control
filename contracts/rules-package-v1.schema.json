{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-pump-control.local/contracts/rules-package-v1.schema.json",
  "title": "Well Pump rules package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "releaseId",
    "rulesVersion",
    "rulesSchemaVersion",
    "sourceWorkbook",
    "rules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "well-pump-rules-release" },
    "releaseId": { "type": "string", "pattern": "^[0-9]{14}-rules-v[0-9]+$" },
    "rulesVersion": { "type": "integer", "minimum": 1 },
    "rulesSchemaVersion": { "const": 1 },
    "sourceWorkbook": { "const": "well_pump_operational_rules_1.xlsx" },
    "rules": {
      "type": "array",
      "minItems": 59,
      "maxItems": 59,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "event",
        "enabled",
        "level",
        "response",
        "confirmSeconds",
        "clearSeconds",
        "conditions",
        "notify",
        "commissioningStatus"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[PETH][0-9]{3}$" },
        "event": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "level": { "type": ["string", "null"], "enum": [null, "Yellow", "Red"] },
        "response": {
          "enum": [
            "Observe",
            "Alert",
            "Trip—while active",
            "Trip—recovery policy",
            "Trip—latched/manual reset"
          ]
        },
        "scheduleContext": { "type": "string" },
        "confirmSeconds": { "type": "integer", "minimum": 1 },
        "clearSeconds": { "type": "integer", "minimum": 1 },
        "conditions": { "type": "object", "minProperties": 1 },
        "operatingContext": { "type": "string" },
        "recoveryResetPolicy": { "type": "string" },
        "notify": { "type": "boolean" },
        "commissioningStatus": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "x-well-pump-completeness": {
    "orderedRuleIds": [
      "P001", "P002", "P003", "P004", "P005", "P006", "P007", "P008", "P009", "P010", "P011", "P012", "P013", "P014", "P015", "P016",
      "E001", "E002", "E003", "E004", "E005", "E006", "E007", "E008", "E009",
      "T001", "T002", "T003", "T004", "T005", "T006", "T007", "T008", "T009", "T010", "T011", "T012", "T013",
      "H001", "H002", "H003", "H004", "H005", "H006", "H007", "H008", "H009", "H010", "H011", "H012", "H013", "H014", "H015", "H016", "H017", "H018", "H019", "H020", "H021"
    ],
    "validation": "The web validator and Tab5 must reject a release unless this is the exact ordered id list. JSON Schema cannot express ordered contains checks portably."
  }
}
