{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-pump-control.local/contracts/current-observation-v1.schema.json",
  "title": "Disposable RTDB current observation v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "siteId", "deviceId", "sessionId", "sequence", "observedAt", "receivedAtMs", "source", "values", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "siteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "deviceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "observedAt": { "type": "string", "format": "date-time" },
    "receivedAtMs": { "type": "integer", "minimum": 0 },
    "source": { "const": "tab5" },
    "rulesRelease": { "$ref": "#/$defs/rulesReference" },
    "values": { "type": "object", "additionalProperties": true },
    "status": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "rulesReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "contentHash"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
