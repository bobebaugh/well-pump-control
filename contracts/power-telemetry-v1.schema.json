{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well-pump-control.local/contracts/power-telemetry-v1.schema.json",
  "title": "Shelly EM well-power telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deviceId",
    "observedAt",
    "power",
    "reactive",
    "voltage",
    "is_valid",
    "total",
    "total_returned"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deviceId": { "const": "shelly-em-well" },
    "observedAt": { "type": "string", "format": "date-time" },
    "power": { "type": "number", "minimum": -100000, "maximum": 100000 },
    "reactive": { "type": "number", "minimum": -100000, "maximum": 100000 },
    "pf": { "type": "number", "minimum": -1, "maximum": 1 },
    "voltage": { "type": "number", "minimum": 0, "maximum": 500 },
    "is_valid": { "type": "boolean" },
    "total": { "type": "number", "minimum": 0 },
    "total_returned": { "type": "number", "minimum": 0 }
  }
}
