{
  "fixture": "KISS complete current-event-board reconciliation",
  "identity": {
    "siteId": "well-main",
    "deviceId": "tab5-well-main"
  },
  "requestDefaults": {
    "schemaVersion": 1,
    "kind": "current-event-board",
    "siteId": "well-main",
    "deviceId": "tab5-well-main",
    "complete": true,
    "producedUptimeMs": 1000,
    "rulesRelease": {
      "releaseId": "20260912001035-event-v3-v15",
      "packageVersion": 15,
      "contentHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "cases": [
    {
      "name": "first complete empty board",
      "input": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "boardSequence": 1, "openEvents": {} },
      "serverReceivedAt": "2026-09-12T16:00:00.000Z",
      "expect": { "decision": "accepted-new-session", "openCreates": [], "closeCreates": [], "onlineKeys": [] }
    },
    {
      "name": "new persistent event appears",
      "input": {
        "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "boardSequence": 2,
        "producedUptimeMs": 20000,
        "producedAt": "2026-09-12T16:00:20.000Z",
        "openEvents": {
          "E007": {
            "occurrenceId": "r15:E007:1",
            "displayName": "Utility voltage high",
            "severity": "Red",
            "eventClass": "latched",
            "opening": { "kind": "condition-qualified", "cycleSequence": 20, "uptimeMs": 20000, "observedAt": "2026-09-12T16:00:20.000Z" }
          }
        }
      },
      "serverReceivedAt": "2026-09-12T16:00:20.100Z",
      "expect": { "decision": "accepted", "openCreates": ["E007/r15:E007:1"], "closeCreates": [], "onlineKeys": ["E007"], "openingEvidenceStatus": "exact-device" }
    },
    {
      "name": "duplicate delivery cannot close",
      "startingProjection": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "lastBoardSequence": 2, "openEvents": { "E007": "r15:E007:1" } },
      "input": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "boardSequence": 2, "sameSemanticContentAsPrevious": true },
      "serverReceivedAt": "2026-09-12T16:00:21.000Z",
      "expect": { "decision": "duplicate", "openCreates": [], "closeCreates": [], "onlineKeys": ["E007"] }
    },
    {
      "name": "missed opening transmission followed by rediscovery",
      "startingProjection": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "lastBoardSequence": 8, "openEvents": {} },
      "input": {
        "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "boardSequence": 12,
        "producedUptimeMs": 12000,
        "openEvents": {
          "H001": {
            "occurrenceId": "r15:H001:1",
            "displayName": "Required source unavailable",
            "severity": "Yellow",
            "eventClass": "monitor",
            "opening": { "kind": "condition-qualified", "cycleSequence": 9, "uptimeMs": 9000 }
          }
        }
      },
      "serverReceivedAt": "2026-09-12T16:05:00.000Z",
      "expect": { "decision": "accepted", "openCreates": ["H001/r15:H001:1"], "closeCreates": [], "openingEvidenceStatus": "reported-open", "onlineKeys": ["H001"] }
    },
    {
      "name": "event remains open across communications outage",
      "startingProjection": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "lastBoardSequence": 12, "openEvents": { "E007": "r15:E007:1" } },
      "input": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "boardSequence": 99, "producedUptimeMs": 3600000, "openEvents": { "E007": { "occurrenceId": "r15:E007:1" } } },
      "serverReceivedAt": "2026-09-12T17:05:00.000Z",
      "expect": { "decision": "accepted", "openCreates": [], "closeCreates": [], "onlineKeys": ["E007"], "stalenessClearedByFreshReport": true }
    },
    {
      "name": "newer complete omission closes immediately",
      "startingProjection": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "lastBoardSequence": 99, "lastBoardProducedUptimeMs": 3600000, "openEvents": { "E007": "r15:E007:1" } },
      "input": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "boardSequence": 100, "producedUptimeMs": 3601000, "openEvents": {} },
      "serverReceivedAt": "2026-09-12T17:05:01.200Z",
      "expect": {
        "decision": "accepted",
        "openCreates": [],
        "closeCreates": ["E007/r15:E007:1"],
        "closeReason": "inferred-board-disappearance",
        "closeTimeStatus": "unknown",
        "detectedAt": "2026-09-12T17:05:01.200Z",
        "serverReceiptBoundsActualClose": false,
        "onlineKeys": []
      }
    },
    {
      "name": "no communication leaves event open but stale",
      "startingProjection": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "openEvents": { "E002": "r15:E002:1" }, "lastReportAt": "2026-09-12T18:00:00.000Z" },
      "now": "2026-09-12T20:00:00.000Z",
      "input": null,
      "expect": { "decision": "no-request-no-op", "closeCreates": [], "onlineKeys": ["E002"], "displayStale": true }
    },
    {
      "name": "new session ends unmatched prior occurrences by restart",
      "startingProjection": { "sessionId": "boot_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "openEvents": { "E002": "r15:E002:1" } },
      "input": { "sessionId": "boot_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "boardSequence": 1, "openEvents": {} },
      "serverReceivedAt": "2026-09-12T20:01:00.000Z",
      "expect": { "decision": "accepted-new-session", "closeCreates": ["E002/r15:E002:1"], "closeReason": "ended-by-restart", "closeTimeStatus": "unknown", "onlineKeys": [] }
    },
    {
      "name": "same key replacement closes old and opens new",
      "startingProjection": { "sessionId": "boot_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "lastBoardSequence": 7, "openEvents": { "E007": "r15:E007:1" } },
      "input": { "sessionId": "boot_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "boardSequence": 8, "openEvents": { "E007": { "occurrenceId": "r15:E007:2" } } },
      "serverReceivedAt": "2026-09-12T20:02:00.000Z",
      "expect": {
        "decision": "accepted",
        "openCreates": ["E007/r15:E007:2"],
        "closeCreates": ["E007/r15:E007:1"],
        "closeReason": "inferred-board-disappearance",
        "closeTimeStatus": "unknown",
        "serverReceiptBoundsActualClose": false,
        "onlineOccurrence": "r15:E007:2"
      }
    },
    {
      "name": "stale and out-of-order omission cannot close",
      "startingProjection": { "sessionId": "boot_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "lastBoardSequence": 20, "openEvents": { "E007": "r15:E007:2" } },
      "input": { "sessionId": "boot_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "boardSequence": 19, "openEvents": {} },
      "expect": { "decision": "stale-ignored", "openCreates": [], "closeCreates": [], "onlineOccurrence": "r15:E007:2" }
    },
    {
      "name": "incomplete and malformed omissions cannot close",
      "startingProjection": { "sessionId": "boot_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB", "lastBoardSequence": 20, "openEvents": { "E007": "r15:E007:2" } },
      "inputs": [
        { "boardSequence": 21, "complete": false, "openEvents": {} },
        { "boardSequence": 22, "complete": true, "openEvents": { "E007": { "occurrenceId": null } } }
      ],
      "expect": { "decisions": ["rejected-incomplete", "rejected-malformed"], "projectionUnchanged": true, "closeCreates": [], "onlineOccurrence": "r15:E007:2" }
    },
    {
      "name": "short event entirely during outage is accepted loss",
      "deviceReality": ["E009 opens", "E009 closes"],
      "deliveredBoards": [{ "boardSequence": 30, "openEventKeys": [] }, { "boardSequence": 40, "openEventKeys": [] }],
      "expect": { "openCreates": [], "closeCreates": [], "documentedAcceptedLoss": true }
    }
  ]
}
