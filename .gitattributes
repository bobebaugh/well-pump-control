# Normalize line endings inside the repository so the protected-baseline digests
# in tests/contract-schemas.test.js hold on every checkout, rather than depending
# on a per-machine core.autocrlf setting. The beta still preserves those exact digests.
# Never "fix" that test by editing its expected digests.
* text=auto eol=lf

# Vendored upstream LVGL 9.2.2 source: keep bytes exactly as shipped and out of
# Git whitespace checks. (ESP-IDF is retained legacy source, not the beta runtime.)
firmware/tab5/components/lvgl/** -whitespace -text
